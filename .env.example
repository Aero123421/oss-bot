# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# SQLite file path (host / container). Compose overrides to /app/data/oss-bot.sqlite
DATABASE_PATH=./data/oss-bot.sqlite

# Shared token gate (required). Send as: Authorization: Bearer <token>
# or header: X-Oss-Bot-Token: <token>
OSS_BOT_TOKEN=change-me-to-a-long-random-string

# Optional: comma-separated CORS origins (empty = same-origin / deny cross-origin in prod)
# CORS_ORIGINS=http://localhost:5173
