# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# SQLite file (Compose overrides to /app/data/oss-bot.sqlite)
DATABASE_PATH=./data/oss-bot.sqlite

# Shared token gate (required)
# Authorization: Bearer <token>  OR  X-Oss-Bot-Token: <token>
OSS_BOT_TOKEN=change-me-to-a-long-random-string

# Bot runtime (P0 = docker). No Redis / No Postgres.
BOT_RUNTIME=docker

# --- DEV overlay only (docker-compose.dev.yml) ---
# DOCKER_HOST=unix:///var/run/docker.sock
# Required when using sock overlay — host docker group id (NOT 0):
#   export DOCKER_GID="$(getent group docker | cut -d: -f3)"
# DOCKER_GID=

# CORS_ORIGINS=http://localhost:5173
