# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# SQLite file (Compose overrides to /app/data/oss-bot.sqlite)
DATABASE_PATH=./data/oss-bot.sqlite

# Shared token gate (required)
# Authorization: Bearer <token>  OR  X-Oss-Bot-Token: <token>
OSS_BOT_TOKEN=change-me-to-a-long-random-string

# Bot runtime (P0 = docker). No Redis / No Postgres.
BOT_RUNTIME=docker

# --- DEV overlay only (docker-compose.dev.yml) ---
# DOCKER_HOST=unix:///var/run/docker.sock
# Required when using sock overlay — host docker group id (NOT 0):
#   export DOCKER_GID="$(getent group docker | cut -d: -f3)"
# DOCKER_GID=

# CORS_ORIGINS=http://localhost:5173

# --- CredBridge RO mounts (docker-compose.dev.yml only) ---
# Host paths (defaults match IF v4). Login stays on the host. Never commit secrets.
# CLAUDE_CONFIG_HOST=${HOME}/.claude
# CODEX_HOME_HOST=${HOME}/.codex
# OPENCODE_DATA_HOST=${HOME}/.local/share/opencode

# Runtime container image (Docker mode)
# RUNTIME_IMAGE=busybox:1.36
